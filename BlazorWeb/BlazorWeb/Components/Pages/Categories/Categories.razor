@page "/Categories"
@using BlazorWeb.Models
@using BlazorWeb.Services.Category
@inject ICategoryService CategoryService
@rendermode InteractiveServer
<h3>Categories</h3>
<a class="btn btn-primary" href="/Categories/Create">Add category</a>
<table class="table table-bordered">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var category in _categories)
    {
        <tr>
            <td>@category.Id</td>
            <td>@category.Name</td>
            <td>@category.Description</td>
            <td>
                <a href="/Categories/@category.Id/Update" class="btn btn-secondary">Edit</a>
                <button class="btn btn-danger" @onclick="() => DeleteCategory(category.Id)">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    List<Category> _categories = new List<Category>();
    
    //Function tu dong load khi goi den component
    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetAllCategoriesAsync();
    }
    
    //Function xoa du lieu
    private async Task DeleteCategory(int Id)
    {
        await CategoryService.DeleteCategoryAsync(Id);
        _categories = await CategoryService.GetAllCategoriesAsync();
    }
}