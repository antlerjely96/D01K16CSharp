@page "/Categories/Create"
@using BlazorWeb.Models
@using BlazorWeb.Services.Category
@inject ICategoryService CategoryService
@rendermode InteractiveServer
<h3>Create</h3>

<EditForm Model="_category" FormName="createCategory" OnValidSubmit="SaveCategory">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>Name: </label>
        <InputText @bind-Value="_category.Name"/>
    </div>
    
    <div class="form-group">
        <label>Description: </label>
        <InputText @bind-Value="_category.Description"/>
    </div>
    
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</EditForm>

@code {
    public Category _category = new Category();
    [Inject] NavigationManager Navigation { get; set; }
    
    private async Task SaveCategory()
    {
        await CategoryService.CreateCategoryAsync(_category);
        //Quay ve danh sach
        Navigation.NavigateTo("/Categories", true);
    }
}